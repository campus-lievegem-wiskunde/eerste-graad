rules_version = '2';
// Toegangsregels voor Cloud Firestore. Plak dit in Firebase → Firestore → Rules en klik op Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    function aangemeld() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower().matches('.*@svsl[.]be$');
    }
    function mail() { return request.auth.token.email.lower(); }
    function beheerder() {
      return aangemeld() && exists(/databases/$(database)/documents/beheerders/$(mail()));
    }
    // toeschouwer (bv. de directeur): mag alles lezen wat een beheerder leest, maar nergens schrijven
    function toeschouwer() {
      return aangemeld() && exists(/databases/$(database)/documents/toeschouwers/$(mail()));
    }
    function leerkracht() {
      return aangemeld() && (beheerder() || exists(/databases/$(database)/documents/leerkrachten/$(mail())));
    }

    // beheerders: jij beheert de lijst; iedereen mag nagaan of hij zelf beheerder is
    match /beheerders/{email} {
      allow read: if aangemeld() && (mail() == email || beheerder() || toeschouwer());
      allow write: if beheerder();
    }
    // leerkrachten met toegang tot het dashboard
    match /leerkrachten/{email} {
      allow read: if leerkracht() || toeschouwer() || (aangemeld() && mail() == email);
      allow write: if beheerder();
    }
    // toeschouwers (bv. de directeur): lezen alles, wijzigingen blijven in hun eigen browser; enkel nagaan of je zelf toeschouwer bent
    match /toeschouwers/{email} {
      allow read: if aangemeld() && (mail() == email || beheerder());
      allow write: if beheerder();
    }
    // jaarlijkse leerlingenlijst (uit Smartschool)
    match /leerlingen/{email} {
      allow read: if leerkracht() || toeschouwer() || (aangemeld() && mail() == email);
      allow write: if beheerder();
    }
    // niveaugroepen: leerkrachten kiezen hun groepen, leerlingen en wat openstaat
    match /groepen/{groep} {
      allow read: if leerkracht() || toeschouwer() || (aangemeld() && mail() in resource.data.leerlingen);
      allow create, delete: if beheerder();
      allow update: if leerkracht();
    }
    // fouten gemeld door leerkrachten: elke leerkracht meldt op eigen naam en ziet zijn eigen meldingen; de beheerder ziet en behandelt alles
    match /fouten/{id} {
      allow create: if leerkracht() && request.resource.data.melder == mail() && request.resource.data.status == 'nieuw';
      allow read: if beheerder() || toeschouwer() || (leerkracht() && resource.data.melder == mail());
      allow update: if beheerder();
      allow delete: if beheerder() || (leerkracht() && resource.data.melder == mail() && resource.data.status == 'nieuw');
    }
    // voortgang: document <uid>_<site>; een leerling leest en schrijft enkel zijn eigen documenten
    match /voortgang/{docId} {
      allow read, write: if aangemeld() && docId.matches(request.auth.uid + '_.*');
      allow read: if leerkracht() || toeschouwer();
      allow delete: if leerkracht();
    }
    // zeeslag tegen elkaar (Module 3): spel per code; elke speler bewaart zijn schepen apart en leest enkel die van zichzelf
    match /zeeslag/{code} {
      allow read: if aangemeld();
      allow create: if aangemeld() && request.resource.data.a == mail() && request.resource.data.b == null;
      allow update: if aangemeld() && (mail() == resource.data.a || mail() == resource.data.b
                    || (resource.data.b == null && request.resource.data.b == mail()));
      allow delete: if leerkracht();
      match /geheim/{email} {
        allow read, write: if aangemeld() && mail() == email;
        allow delete: if leerkracht();
      }
    }
    // toetsen, huistaken en rekenvaardigheden: antwoorden van een leerling (document <opdracht>__<e-mail>);
    // de leerling schrijft enkel zijn eigen document, en na het indienen bij één poging (slot) niets meer
    match /inzendingen/{id} {
      allow read: if leerkracht() || toeschouwer() || (aangemeld() && id.split('__')[1] == mail());
      allow create: if aangemeld() && id.split('__')[1] == mail() && request.resource.data.email == mail();
      allow update: if aangemeld() && id.split('__')[1] == mail() && request.resource.data.email == mail() && resource.data.get('slot', false) != true;
      allow update, delete: if leerkracht();
    }
    // verbetersleutels: enkel leerkrachten (de leerling ziet ze nooit)
    match /sleutels/{id} {
      allow read: if leerkracht() || toeschouwer();
      allow write: if leerkracht();
    }
    // punten per leerling: de leerkracht schrijft; de leerling leest zijn eigen resultaat pas als het vrijgegeven is
    match /resultaten/{id} {
      allow read: if leerkracht() || toeschouwer() || (aangemeld() && id.split('__')[1] == mail() && resource.data.vrij == true);
      allow write: if leerkracht();
    }
    // klassessie (Module 3): de leerkracht start een sessie met een code; de leerlingen doen tegelijk een experiment en het bord toont live de resultaten
    match /klassessie/{code} {
      allow read: if aangemeld();
      allow create: if leerkracht() && request.resource.data.lk == mail();
      allow update, delete: if leerkracht() && (resource.data.lk == mail() || beheerder());
      match /deelnemers/{email} {
        allow read: if leerkracht() || (aangemeld() && mail() == email);
        allow create, update: if aangemeld() && mail() == email
                              && exists(/databases/$(database)/documents/klassessie/$(code));
        allow delete: if leerkracht() || (aangemeld() && mail() == email);
      }
    }
  }
}
